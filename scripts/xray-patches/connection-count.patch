+// Package geekstats is GeekVPN's addition to the core: counters the app
+// reads through libv2ray. See scripts/xray-patches/README.md.
+package geekstats
+
+import "sync/atomic"
+
+// Active is the number of outbound connections being carried right now.
+// Connections a mux session carries are not counted one by one.
+var Active atomic.Int64
