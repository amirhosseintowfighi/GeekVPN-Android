<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the component catalog, with its own launcher entry for design review,
     and single-screen previews with sample data (started from adb). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.geekvpn.ui.catalog.CatalogActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/geek_catalog_title"
            android:taskAffinity="com.geekvpn.catalog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.geekvpn.ui.catalog.ScreenPreviewActivity"
            android:exported="true"
            android:taskAffinity="com.geekvpn.catalog" />
    </application>
</manifest>
